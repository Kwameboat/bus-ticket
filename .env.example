APP_NAME="GhanaBus Connect"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Accra
APP_URL=https://YOUR_APP_NAME.herokuapp.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# On Heroku, logs should go to stderr (captured by heroku logs --tail)
LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Database ---
# For Heroku, add ClearDB MySQL (heroku addons:create cleardb:ignite)
# ClearDB auto-sets CLEARDB_DATABASE_URL; parse it as DB_URL or set manually:
# DB_URL=${CLEARDB_DATABASE_URL}
# Or set individual vars after provisioning:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ghanabusconnect
DB_USERNAME=gbc_user
DB_PASSWORD=your_secure_password

# --- Sessions & Cache ---
# On Heroku, use database or cookie sessions (filesystem is ephemeral)
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="GhanaBus Connect"

PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_MERCHANT_EMAIL=payments@yourdomain.com

OPENAI_API_KEY=
CLAUDE_API_KEY=
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini

PWA_APP_NAME="GhanaBus Connect"
PWA_SHORT_NAME="GhanaBus"
PWA_THEME_COLOR="#1A56DB"
PWA_BG_COLOR="#FFFFFF"

FILESYSTEM_DISK=local

