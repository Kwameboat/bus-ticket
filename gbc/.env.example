APP_NAME="GhanaBus Connect"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Accra
APP_URL=https://yourdomain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Standard MySQL (cPanel / VPS) ─────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ghanabusconnect
DB_USERNAME=gbc_user
DB_PASSWORD=your_secure_password

# ── Heroku / cloud deployments ────────────────────────────────────────────────
# Heroku sets DATABASE_URL automatically when the Heroku Postgres add-on is
# attached.  The app reads this variable and selects the pgsql driver for you.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# For MySQL on Heroku use JawsDB: heroku addons:create jawsdb
# DATABASE_URL=mysql://user:pass@host:3306/dbname

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="GhanaBus Connect"

PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_MERCHANT_EMAIL=payments@yourdomain.com

OPENAI_API_KEY=
CLAUDE_API_KEY=
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini

PWA_APP_NAME="GhanaBus Connect"
PWA_SHORT_NAME="GhanaBus"
PWA_THEME_COLOR="#1A56DB"
PWA_BG_COLOR="#FFFFFF"

FILESYSTEM_DISK=local
